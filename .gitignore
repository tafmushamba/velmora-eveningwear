# Only the runnable app, its assets, tests and setup files belong in this repo.
# Everything else in this assessment workspace stays local by default.
/*
!/.gitignore
!/README.md
!/.env.example
!/package.json
!/package-lock.json
!/tsconfig.json
!/vite.config.ts
!/netlify.toml
!/index.html
!/black-friday.html
!/collection.html
!/product.html
!/studio.html
!/client-care.html

!/src/
/src/*
!/src/*.ts
!/src/*.css
!/src/image-manifest.json
!/src/colour-manifest.json

!/server/
/server/*
!/server/*.ts
!/shared/
/shared/*
!/shared/*.ts

!/netlify/
/netlify/*
!/netlify/functions/
/netlify/functions/*
!/netlify/functions/*.ts

!/scripts/
/scripts/*
!/scripts/catalogue-images.mjs
!/scripts/colour-images.mjs

!/data/
/data/*
!/data/products.json
!/data/store-policy.json

!/public/
/public/*
!/public/images/
/public/images/*
!/public/images/*.webp

!/tests/
/tests/*
!/tests/*.test.ts

# Never include local credentials, dependencies, build output or review material.
**/.env*
!/.env.example
**/*.pem
**/*.key
**/.DS_Store
node_modules/
dist/
output/
docs/
deliverables/
evidence/
.codex/
.impeccable/
.netlify/
.playwright-cli/
